      "fontSize": 25,
      "fontFamily": 2,
      "text": "ЖИЗНЕННЫЙ ЦИКЛ РЕЛИЗА",
      "originalText": "ЖИЗНЕННЫЙ ЦИКЛ РЕЛИЗА",

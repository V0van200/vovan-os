      "locked": false,
      "fontSize": 25,
      "fontFamily": 2,
      "text": "ЛОКАЛЬНЫЙ УЗЕЛ / SENTRA",
      "originalText": "ЛОКАЛЬНЫЙ УЗЕЛ / SENTRA",

    {
      "id": "670772817c5e47749b2a",
      "type": "text",
      "x": 2560,
      "y": 3469.5,
      "width": 740,
      "height": 156.0,
      "angle": 0,
      "strokeColor": "#e8f1fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "f50e69de2c2a4b7ea04b-group"
      ],
      "frameId": "b49ee1c7ba904a13b1b9",
      "roundness": null,
      "seed": 330,
      "version": 1,
      "versionNonce": 429,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791115200000,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 2,
      "text": "README явно сообщает о credentials, session keys, HF token и SSH.\nЗначения ключей не читались и в схему не включены.\nДо подключения: проверить актуальность и отозвать / заменить их;\nсекреты исключить из общего поиска и импорта.\nПереписывание истории — отдельная операция, здесь не\nвыполнялась.",
      "originalText": "README явно сообщает о credentials, session keys, HF token и SSH.\nЗначения ключей не читались и в схему не включены.\nДо подключения: проверить актуальность и отозвать / заменить их;\nсекреты исключить из общего поиска и импорта.\nПереписывание истории — отдельная операция, здесь не\nвыполнялась.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.3,
      "autoResize": false
    },

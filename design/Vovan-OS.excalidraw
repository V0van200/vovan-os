      "type": "text",
      "x": 4280,
      "y": 2239.5,
      "width": 740,
      "height": 130.0,
      "angle": 0,
      "strokeColor": "#e8f1fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,

      "locked": false,
      "fontSize": 25,
      "fontFamily": 2,
      "text": "НЕ ПОДМЕНЯТЬ ФАКТЫ ГЕНЕРАЦИЕЙ",
      "originalText": "НЕ ПОДМЕНЯТЬ ФАКТЫ ГЕНЕРАЦИЕЙ",

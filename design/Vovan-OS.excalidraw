    },
    {
      "id": "8e3f1f1faa0c41d9b297",
      "type": "text",
      "x": 3500,
      "y": 869.5,
      "width": 700,
      "height": 156.0,
      "angle": 0,
      "strokeColor": "#e8f1fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "d4ea4d3c7ff2489ebf30-group"
      ],
      "frameId": "becfe232c2db446aa5bd",
      "roundness": null,
      "seed": 97,
      "version": 1,
      "versionNonce": 196,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791115200000,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 2,
      "text": "Строго локальный: исходящие AI-запросы отключены.\nСинхронизация: только выбранные GitHub и серверные\nисточники.\nОблачный AI: отдельный opt-in по проекту и типу данных.\nПубличные сайты не имеют маршрута к локальному storage.\nЛокальный frontend без CDN, аналитики и внешних шрифтов.",
      "originalText": "Строго локальный: исходящие AI-запросы отключены.\nСинхронизация: только выбранные GitHub и серверные\nисточники.\nОблачный AI: отдельный opt-in по проекту и типу данных.\nПубличные сайты не имеют маршрута к локальному storage.\nЛокальный frontend без CDN, аналитики и внешних шрифтов.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.3,
      "autoResize": false
    },

    },
    {
      "id": "a3bd80e7c51741b79f5f",
      "type": "text",
      "x": 2560,
      "y": 3109.5,
      "width": 740,
      "height": 156.0,
      "angle": 0,
      "strokeColor": "#e8f1fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "0271f50b7fa240e39cae-group"
      ],
      "frameId": "b49ee1c7ba904a13b1b9",
      "roundness": null,
      "seed": 324,
      "version": 1,
      "versionNonce": 423,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791115200000,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 2,
      "text": "Отделять сказанную цитату от AI-интерпретации.\nКаждый фрагмент: source, document_version, page / timecode.\nПоиск выполняет ACL-фильтрацию до передачи контекста модели.\nДубликаты по hash объединяют хранение, но сохраняют источники.\nИзменение исходника создаёт новую версию и переиндексацию.\nИндекс / embeddings — производные, их можно пересоздать.",
      "originalText": "Отделять сказанную цитату от AI-интерпретации.\nКаждый фрагмент: source, document_version, page / timecode.\nПоиск выполняет ACL-фильтрацию до передачи контекста модели.\nДубликаты по hash объединяют хранение, но сохраняют источники.\nИзменение исходника создаёт новую версию и переиндексацию.\nИндекс / embeddings — производные, их можно пересоздать.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.3,
      "autoResize": false
    },

      "lineHeight": 1.3,
      "autoResize": false
    },
    {
      "id": "aa0da446f6e84df7a9f1",
      "type": "text",
      "x": 3500,
      "y": 549.5,
      "width": 700,
      "height": 182.0,
      "angle": 0,
      "strokeColor": "#e8f1fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "fa72cb4db1f7420ba946-group"
      ],
      "frameId": "becfe232c2db446aa5bd",
      "roundness": null,
      "seed": 91,
      "version": 1,
      "versionNonce": 190,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791115200000,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 2,
      "text": "GitHub — код и метаданные репозитория.\nРабочая БД проекта — пользователи и игровые / бизнес-данные.\nЛокальное ядро — каталог, заметки владельца, история\nсинхронизации.\nФайлы — версии по hash; происхождение сохраняется.\nРедактирование удалённых данных — только через API\nвладельца.",
      "originalText": "GitHub — код и метаданные репозитория.\nРабочая БД проекта — пользователи и игровые / бизнес-данные.\nЛокальное ядро — каталог, заметки владельца, история\nсинхронизации.\nФайлы — версии по hash; происхождение сохраняется.\nРедактирование удалённых данных — только через API\nвладельца.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.3,
      "autoResize": false
    },
    {
      "id": "72bd421ac14e47c28f24",

        "a395606cf28f441ba438-group"
      ],
      "frameId": "03bc0fd58c5940a6a4c8",
      "roundness": null,
      "seed": 263,
      "version": 1,
      "versionNonce": 362,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791115200000,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 2,
      "text": "Read-only инвентаризация: Docker / systemd / pm2, nginx, пути.\nДля каждого: project_id, host_id, runtime, volumes, DB, endpoint.\nНет Git → source_type=server; maturity=unknown / draft.\nСекреты и содержимое БД не выгружать в общий каталог.",
      "originalText": "Read-only инвентаризация: Docker / systemd / pm2, nginx, пути.\nДля каждого: project_id, host_id, runtime, volumes, DB, endpoint.\nНет Git → source_type=server; maturity=unknown / draft.\nСекреты и содержимое БД не выгружать в общий каталог.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.3,
      "autoResize": false
    },

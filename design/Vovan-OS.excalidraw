      "link": null,
      "locked": false,
      "fontSize": 25,
      "fontFamily": 2,
      "text": "КТО ВЛАДЕЕТ ДАННЫМИ",
      "originalText": "КТО ВЛАДЕЕТ ДАННЫМИ",
      "textAlign": "left",
      "verticalAlign": "top",

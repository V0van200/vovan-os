    {
      "id": "0d11966cbf5a416095c8",
      "type": "text",
      "x": 4280,
      "y": 869.5,
      "width": 740,
      "height": 130.0,
      "angle": 0,
      "strokeColor": "#e8f1fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "5415f3956041470fa015-group"
      ],
      "frameId": "becfe232c2db446aa5bd",
      "roundness": null,
      "seed": 100,
      "version": 1,
      "versionNonce": 199,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791115200000,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 2,
      "text": "Кнопка → проверка прав → plan → подтверждение опасной операции\n→ очередь → разрешённый серверный runner → audit + результат.\nidempotency_key, срок действия и версия целевого deployment.\nУстаревшую команду после офлайн не выполнять автоматически.\nОбновление каталога само по себе никогда не запускает деплой.",
      "originalText": "Кнопка → проверка прав → plan → подтверждение опасной операции\n→ очередь → разрешённый серверный runner → audit + результат.\nidempotency_key, срок действия и версия целевого deployment.\nУстаревшую команду после офлайн не выполнять автоматически.\nОбновление каталога само по себе никогда не запускает деплой.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.3,
      "autoResize": false
    },

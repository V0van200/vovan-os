      "type": "text",
      "x": 3500,
      "y": 2239.5,
      "width": 700,
      "height": 104.0,
      "angle": 0,
      "strokeColor": "#e8f1fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",

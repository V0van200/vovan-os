      "link": null,
      "locked": false,
      "fontSize": 25,
      "fontFamily": 2,
      "text": "VPS / ВНЕШНИЕ УЗЛЫ",
      "originalText": "VPS / ВНЕШНИЕ УЗЛЫ",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.3,
      "autoResize": false
    },
    {
      "id": "11c84bb08d8148b89c58",
      "type": "text",
      "x": 2560,
      "y": 4059.5,
      "width": 740,
      "height": 182.0,
      "angle": 0,
      "strokeColor": "#e8f1fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "233af4d6a65d4e778758-group"
      ],
      "frameId": "fc2128332ee24454827e",
      "roundness": null,
      "seed": 416,
      "version": 1,
      "versionNonce": 515,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791115200000,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 2,
      "text": "Существующие сервисы продолжают работу независимо.\nVPS-адаптер отдаёт разрешённые метаданные / snapshots.\nRunner принимает только заранее заданные команды.\nTerraria: сохранить build → save world → restart → rollback.\nKabluk: выбрать D1 или self-host; переносить данные отдельно.\nТелефон: Video2MD экспортирует результат при доступной сети.\nTelegram / Twitch / облачные AI требуют внешнего соединения.",
      "originalText": "Существующие сервисы продолжают работу независимо.\nVPS-адаптер отдаёт разрешённые метаданные / snapshots.\nRunner принимает только заранее заданные команды.\nTerraria: сохранить build → save world → restart → rollback.\nKabluk: выбрать D1 или self-host; переносить данные отдельно.\nТелефон: Video2MD экспортирует результат при доступной сети.\nTelegram / Twitch / облачные AI требуют внешнего соединения.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.3,
      "autoResize": false
    },

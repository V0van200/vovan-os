    },
    {
      "id": "830f3a8ca454427abc68",
      "type": "text",
      "x": 1780,
      "y": 3469.5,
      "width": 700,
      "height": 104.0,
      "angle": 0,
      "strokeColor": "#e8f1fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "f1fe44fbfca84c798b5d-group"
      ],
      "frameId": "b49ee1c7ba904a13b1b9",
      "roundness": null,
      "seed": 327,
      "version": 1,
      "versionNonce": 426,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791115200000,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 2,
      "text": "Согласованный manifest: версия БД + список объектов + hash.\nШифрованная копия на отдельный диск / NAS, ключ отдельно.\nПроверка восстановления в чистую среду и выборочных файлов.\nПолитику retention / RPO / RTO задать по доступному диску.",
      "originalText": "Согласованный manifest: версия БД + список объектов + hash.\nШифрованная копия на отдельный диск / NAS, ключ отдельно.\nПроверка восстановления в чистую среду и выборочных файлов.\nПолитику retention / RPO / RTO задать по доступному диску.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.3,
      "autoResize": false
    },

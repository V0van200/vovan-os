    },
    {
      "id": "1fdf53979c794a1da3db",
      "type": "text",
      "x": 2560,
      "y": 4494.5,
      "width": 740,
      "height": 208.0,
      "angle": 0,
      "strokeColor": "#e8f1fa",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "4d8fcd3d38ba4f819c8d-group"
      ],
      "frameId": "fc2128332ee24454827e",
      "roundness": null,
      "seed": 422,
      "version": 1,
      "versionNonce": 521,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791115200000,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 2,
      "text": "Commit → CI checks → versioned artifact → staging\n→ backup / migration plan → deploy → health → active.\nОшибка → rollback приложения; БД — совместимые миграции\nили восстановление по заранее проверенному плану.\nЛоги по project_id / service_id / run_id, с удалением секретов.\nСигналы: sync age, failed jobs, disk free, backup age, health.\nСроки хранения логов и квоты защищают локальный диск.\nЦентральная панель не должна быть условием работы игр и сайтов.",
      "originalText": "Commit → CI checks → versioned artifact → staging\n→ backup / migration plan → deploy → health → active.\nОшибка → rollback приложения; БД — совместимые миграции\nили восстановление по заранее проверенному плану.\nЛоги по project_id / service_id / run_id, с удалением секретов.\nСигналы: sync age, failed jobs, disk free, backup age, health.\nСроки хранения логов и квоты защищают локальный диск.\nЦентральная панель не должна быть условием работы игр и сайтов.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.3,
      "autoResize": false
    },
    {
      "id": "0e1c329ab565489aa672",
      "type": "text",
      "x": 1760,
      "y": 4890,
      "width": 1560,
      "height": 28.6,
      "angle": 0,
      "strokeColor": "#ffd080",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "fc2128332ee24454827e",
      "roundness": null,
      "seed": 423,
      "version": 1,
      "versionNonce": 522,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791115200000,
      "link": null,
      "locked": false,
      "fontSize": 22,
      "fontFamily": 2,
      "text": "Публичный деплой этой схемой не выполняется. Ни репозитории, ни серверы, ни работающие базы в ходе работы не менялись.",
      "originalText": "Публичный деплой этой схемой не выполняется. Ни репозитории, ни серверы, ни работающие базы в ходе работы не менялись.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.3,
      "autoResize": false
    },

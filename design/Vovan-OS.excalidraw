    {
      "id": "f98164d0c88d49f48412",
      "type": "text",
      "x": 840,
      "y": 760,
      "width": 740,
      "height": 65.0,
      "angle": 0,
      "strokeColor": "#ffd080",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,

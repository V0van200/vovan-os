[Unit]
Description=VOVAN OS Hub online API and change stream
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/vovan-os-hub-api/current
Environment=HUB_API_HOST=127.0.0.1
Environment=HUB_API_PORT=3980
Environment=HUB_API_SNAPSHOT=/data/vovan-os-hub/live/snapshot.json
Environment=HUB_API_PROJECTS=/data/vovan-os-hub/live/projects.json
Environment=HUB_API_DB=/data/vovan-os-hub/state/hub.sqlite3
ExecStart=/usr/bin/python3 /opt/vovan-os-hub-api/current/server.py
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_UNIX
ReadOnlyPaths=/data/vovan-os-hub/live
ReadWritePaths=/data/vovan-os-hub/state

[Install]
WantedBy=multi-user.target

